# Copy this file to .env and fill in the values there. The .env file is git-ignored and must never be committed.

# Your Meta Model API key (dev.meta.ai -> API keys). Required.
MODEL_API_KEY=

# Passcode town staff type to open the staff portal. Pick something long. Required before going online.
STAFF_PASSCODE=

# Random secret used to sign the staff cookie. Any long random string. Required before going online.
COOKIE_SECRET=

# Optional. Meta model for the resident pipeline (default muse-spark-1.3).
META_MODEL=muse-spark-1.3

# Optional. Meta model for the staff pre-review step (default: same as META_MODEL). Try muse-wonder-1.0 to compare.
META_MODEL_REVIEW=

# Optional. Maximum model calls per day before the app pauses itself (protects the credits). Default 400.
DAILY_CALL_CAP=400
# The public's dollars per day at Meta's list prices; 8.5 is about $60 a week. Judges are not counted.
DAILY_BUDGET_USD=8.5
# The code in the private judge link, /judge?code=... At least 12 characters.
JUDGE_CODE=

# Optional. Folder for the SQLite database and usage log (default ./data/runtime). On Render: /var/data
DATA_DIR=

# Optional. Port to listen on (default 3000).
PORT=3000

# Optional, local only, kept in .env.render.local (git-ignored): Render API key so an agent can create/inspect the deploy. Render dashboard -> Account Settings -> API Keys.
# RENDER_API_KEY=

# Optional: send every Meta call through a relay (see relay/README.md). Leave blank to call Meta directly.
META_API_BASE=
# Optional: shared secret the relay checks (same value set on the relay as RELAY_SECRET).
META_RELAY_SECRET=

# Video only (not the app): Google voice for the demo video narration. Keep these in .env.google-tts.local.
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=
