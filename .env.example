# Copy this file to .env and fill in the values there. The .env file is git-ignored and must never be committed.

# Your Meta Model API key (dev.meta.ai -> API keys). Required.
MODEL_API_KEY=

# Passcode town staff type to open the staff portal. Pick something long. Required before going online.
STAFF_PASSCODE=

# Random secret used to sign the staff cookie. Any long random string. Required before going online.
COOKIE_SECRET=

# Optional. Meta model for the resident pipeline (default muse-spark-1.3).
META_MODEL=muse-spark-1.3

# Optional. Meta model for the staff pre-review step (default: same as META_MODEL). Try muse-wonder-1.0 to compare.
META_MODEL_REVIEW=

# Optional. Maximum model calls per day before the app pauses itself (protects the credits). Default 400.
DAILY_CALL_CAP=400

# Optional. Folder for the SQLite database and usage log (default ./data/runtime). On Render: /var/data
DATA_DIR=

# Optional. Port to listen on (default 3000).
PORT=3000
